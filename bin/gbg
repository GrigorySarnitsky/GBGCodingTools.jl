#!/bin/sh
# gbg — the per-machine shim. `gbg install` copies this file to ~/.local/bin/gbg byte for byte (SHIM.HASH
# compares the two). It holds no Julia code and reads no depot slug: it only decides which --project to
# exec Julia against. Pkg's resolution of that environment IS the version selection (docs/ARCHITECTURE.md D2).
set -u
JL='using GBGCodingTools; exit(GBGCodingTools.main(ARGS))'
devpath() {
  [ -f "$HOME/.gbg/dev" ] || { echo "gbg: no dev checkout registered (~/.gbg/dev is absent; run gbg install --dev-checkout <path>)" >&2; exit 2; }
  head -n 1 "$HOME/.gbg/dev"
}
if [ "${1:-}" = "--dev" ]; then                       # (1) explicit dev route
  shift; P=$(devpath) || exit 2
  # the same question the pinned route asks: a fresh clone has no Manifest (it is git-ignored), and
  # Julia's package-loading error is not the line that says what to run
  [ -f "$P/Manifest.toml" ] || { echo "gbg: the dev checkout $P is not instantiated" >&2; echo "run: julia --project=\"$P\" -e 'using Pkg; Pkg.instantiate()'" >&2; exit 2; }
  # this command is a copy of the checkout's `bin/gbg`, made by `gbg install` once per machine, and nothing
  # else says when that copy has fallen behind: one machine ran a copy predating the review's fixes to it
  # (found wiring GBGHomogeneousTurbulence, 2026-09-28). It warns and goes on; the copy still works.
  cmp -s "$0" "$P/bin/gbg" 2>/dev/null || echo "gbg: this command differs from the dev checkout's bin/gbg; run: gbg --dev install" >&2
else
  d=$PWD                                             # (2) walk up to the nearest .gbg/ with a config
  while [ "$d" != "/" ] && [ ! -f "$d/.gbg/config.jl" ]; do d=$(dirname "$d"); done
  if [ ! -f "$d/.gbg/config.jl" ]; then
    # No config anywhere above the working directory. This used to fall through to the dev checkout
    # SILENTLY, so a command typed in the wrong directory ran against a different package's tree and
    # said nothing. It refuses instead, and says where it looked.
    echo "gbg: no .gbg/config.jl in $PWD or any directory above it" >&2
    # A first wiring is the one verb that must run here: the config it writes is what picks a version
    # later, so it goes through the dev checkout, and the refusal names the command.
    if [ "${1:-}" = "init" ]; then
      echo "     a first wiring runs through the dev checkout: gbg --dev init" >&2
    else
      echo "     (run it inside a package, or use: gbg --dev <verb> for the dev checkout)" >&2
    fi
    exit 2
  else
    # (3) the pinned version, read from the config as text: the LEFTMOST `tool =` on a line that is not
    # a comment, so neither a comment above the config nor one trailing the pin line is read as the pin
    v=$(awk '/^[ \t]*#/ {next} match($0, /(^|[(, \t])tool[ \t]*=[ \t]*(:dev|v"[^"]*")/) {s = substr($0, RSTART, RLENGTH); if (s ~ /:dev$/) print "dev"; else {sub(/^[^"]*"/, "", s); sub(/"$/, "", s); print s}; exit}' "$d/.gbg/config.jl")
    if [ "$v" = "dev" ] && ! grep -q '^name = "GBGCodingTools"' "$d/Project.toml" 2>/dev/null; then   # (4) the fixture: enclosing tool repo
      r=$d; while [ "$r" != "/" ] && ! grep -q '^name = "GBGCodingTools"' "$r/Project.toml" 2>/dev/null; do r=$(dirname "$r"); done
      grep -q '^name = "GBGCodingTools"' "$r/Project.toml" 2>/dev/null || { echo "gbg: pin is dev but no enclosing GBGCodingTools repository" >&2; exit 2; }
      P=$r
    else                                             # (5) the ordinary route: the consumer's docs environment (the tool root included)
      P="$d/docs"
      grep -q 'GBGCodingTools' "$P/Manifest.toml" 2>/dev/null || { echo "gbg: package not instantiated in $P" >&2; echo "run: julia --project=docs -e 'using Pkg; Pkg.instantiate()'" >&2; exit 2; }
    fi
  fi
fi
exec julia --startup-file=no --project="$P" -e "$JL" -- "$@"
