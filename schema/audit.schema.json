{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "additionalProperties": false,
 "required": [
  "schema_version",
  "round",
  "base",
  "head",
  "kind",
  "covered",
  "executable_claims",
  "dispositions"
 ],
 "properties": {
  "head": {
   "pattern": "^[0-9a-f]{40}$",
   "type": "string"
  },
  "executable_claims": {
   "items": {
    "additionalProperties": false,
    "required": [
     "command",
     "exit"
    ],
    "properties": {
     "exit": {
      "type": "integer"
     },
     "log": {
      "type": "string"
     },
     "command": {
      "type": "string"
     },
     "file": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "type": "array"
  },
  "covered": {
   "items": {
    "type": "string"
   },
   "type": "array"
  },
  "kind": {
   "type": "string",
   "enum": [
    "code",
    "prose",
    "both"
   ]
  },
  "base": {
   "pattern": "^[0-9a-f]{40}$",
   "type": "string"
  },
  "verdict_all_clean": {
   "type": "boolean"
  },
  "dispositions": {
   "additionalProperties": true,
   "required": [],
   "properties": {},
   "type": "object",
   "description": "finding id \u2192 {state, reason?, overturn_when?}"
  },
  "diffstat": {
   "type": "string"
  },
  "schema_version": {
   "minimum": 1,
   "type": "integer",
   "description": "the tool MAJOR this artefact was written under"
  },
  "round": {
   "pattern": "^\\d{4}-\\d{2}-\\d{2}-(check-docs|check-consistency|bug-hunt|audit-changes)-\\d{2}$",
   "type": "string"
  }
 },
 "title": "audit.json \u2014 the audit-changes round record written by `gbg audit-changes bank`",
 "type": "object",
 "description": ""
}
