{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": ".gbg/calibrations/<id>/rubric-audit.json — what rubric-audit.js writes for `gbg calibrate`",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema_version",
  "round",
  "tally",
  "unassigned",
  "misassigned",
  "orphaned",
  "gaps",
  "scores",
  "byHat"
 ],
 "properties": {
  "schema_version": {
   "type": "integer",
   "minimum": 1,
   "description": "the tool MAJOR this artefact was written under"
  },
  "round": {
   "type": "string",
   "description": "the calibration's id"
  },
  "tally": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "CAUGHT",
    "PARTIAL",
    "MISSED"
   ],
   "properties": {
    "CAUGHT": {
     "type": "integer",
     "minimum": 0
    },
    "PARTIAL": {
     "type": "integer",
     "minimum": 0
    },
    "MISSED": {
     "type": "integer",
     "minimum": 0
    }
   },
   "description": "best-of verdicts across the hats each finding was assigned to"
  },
  "unassigned": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "hats",
     "why"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "hats": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "why": {
      "type": "string"
     }
    }
   },
   "description": "findings no persona's rubric covers"
  },
  "misassigned": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "hat",
     "ids"
    ],
    "properties": {
     "hat": {
      "type": "string"
     },
     "ids": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   },
   "description": "findings assigned to a hat outside this roster"
  },
  "orphaned": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "findings assigned only to a hat outside this roster, so read by no hat"
  },
  "gaps": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "hat",
     "verdict",
     "evidence"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "hat": {
      "type": "string"
     },
     "verdict": {
      "type": "string",
      "enum": [
       "CAUGHT",
       "PARTIAL",
       "MISSED"
      ]
     },
     "evidence": {
      "type": "string"
     }
    }
   }
  },
  "scores": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "hat",
     "verdict",
     "evidence"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "hat": {
      "type": "string"
     },
     "verdict": {
      "type": "string",
      "enum": [
       "CAUGHT",
       "PARTIAL",
       "MISSED"
      ]
     },
     "evidence": {
      "type": "string"
     }
    }
   }
  },
  "byHat": {
   "type": "object",
   "description": "hat key → the finding ids assigned to it"
  }
 }
}
