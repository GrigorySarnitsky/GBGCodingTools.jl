{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "round",
    "lane",
    "candidates_found",
    "checked",
    "findings"
  ],
  "properties": {
    "checked": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "candidates_found": {
      "minimum": 0,
      "type": "integer"
    },
    "lane": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "type": "string"
    },
    "schema_version": {
      "minimum": 1,
      "type": "integer",
      "description": "the tool MAJOR this artefact was written under"
    },
    "round": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-(check-docs|check-consistency|bug-hunt|audit-changes)-\\d{2}$",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/finding"
      },
      "type": "array"
    }
  },
  "title": "findings/NN-<lane>.json — written by a lane agent FIRST, before it returns",
  "$defs": {
    "finding": {
      "additionalProperties": false,
      "required": [
        "type",
        "severity",
        "confidence",
        "title",
        "locations",
        "description"
      ],
      "properties": {
        "domain_type": {
          "type": "string",
          "description": "one of config [schema] finding_types_extra"
        },
        "after": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "blocker",
            "major",
            "minor",
            "nit"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "justified": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unclear"
          ]
        },
        "before": {
          "type": "string"
        },
        "locations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "contradicts": {
          "type": "string"
        },
        "previously_worked": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "why_it_matters": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 8
        },
        "resolution_hint": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "description": "core type; a domain type goes in domain_type",
          "enum": [
            "math",
            "notation",
            "structure",
            "citation",
            "style",
            "operational",
            "currency",
            "self-containment"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 20
        }
      },
      "type": "object"
    }
  },
  "type": "object"
}
