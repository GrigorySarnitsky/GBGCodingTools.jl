{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "severity",
    "verdict",
    "observed",
    "evidence"
  ],
  "properties": {
    "severity": {
      "type": "string",
      "enum": [
        "blocker",
        "major",
        "minor",
        "nit"
      ]
    },
    "witness_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "observed": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "runtime",
        "architecture",
        "api-semantics"
      ]
    },
    "disposition": {
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "overturn_when": {
          "type": "string",
          "minLength": 12,
          "description": "REQUIRED with escalated"
        },
        "reason": {
          "type": "string",
          "minLength": 24,
          "description": "REQUIRED with refused"
        },
        "promoted_to": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "description": "open — the state bank writes for every REPRODUCED or EVIDENCED finding, before any disposition is recorded",
          "enum": [
            "open",
            "fixed",
            "refused",
            "escalated"
          ]
        }
      },
      "type": "object"
    },
    "id": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z-]+-\\d{2}/[a-z0-9-]+#\\d+$",
      "type": "string",
      "description": "<round>/<lane>#<n>"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "REPRODUCED",
        "EVIDENCED",
        "NOT-REPRODUCED",
        "WITNESS-WRONG",
        "NO-WITNESS-POSSIBLE",
        "BLOCKED",
        "ALREADY-COVERED",
        "NOT-A-DEFECT"
      ]
    },
    "title": {
      "type": "string"
    },
    "witness_path": {
      "type": "string",
      "description": "REPRODUCED/BLOCKED: witnesses/<lane>-<n>.jl relative to the round"
    },
    "schema_version": {
      "minimum": 1,
      "type": "integer",
      "description": "the tool MAJOR this artefact was written under"
    },
    "evidence": {
      "type": "string"
    },
    "docs_url": {
      "type": "string"
    },
    "blocked_reason": {
      "type": "string"
    }
  },
  "title": "reproductions/<id>.json — the reproduction verdict and the disposition record, frozen at bank",
  "type": "object"
}
