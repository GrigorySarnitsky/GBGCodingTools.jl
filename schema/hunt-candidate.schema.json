{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "round",
    "lane",
    "files_read",
    "candidates_found",
    "candidates"
  ],
  "properties": {
    "candidates_found": {
      "minimum": 0,
      "type": "integer"
    },
    "files_read": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "lane": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "type": "string"
    },
    "schema_version": {
      "minimum": 1,
      "type": "integer",
      "description": "the tool MAJOR this artefact was written under"
    },
    "round": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-(check-docs|check-consistency|bug-hunt|audit-changes)-\\d{2}$",
      "type": "string"
    },
    "candidates": {
      "items": {
        "additionalProperties": false,
        "required": [
          "kind",
          "severity",
          "title",
          "file",
          "line",
          "mechanism",
          "witness_plan"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "runtime",
              "architecture",
              "api-semantics"
            ]
          },
          "line": {
            "minimum": 1,
            "type": "integer"
          },
          "second_location": {
            "type": "string"
          },
          "mechanism": {
            "type": "string",
            "minLength": 20
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocker",
              "major",
              "minor",
              "nit"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 8
          },
          "file": {
            "type": "string"
          },
          "witness_plan": {
            "type": "string",
            "minLength": 20
          }
        },
        "type": "object"
      },
      "type": "array"
    }
  },
  "title": "candidates/NN-<lane>.json — a hunter lane's hypotheses",
  "type": "object"
}
