{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "round",
    "salt",
    "seeded",
    "skipped"
  ],
  "properties": {
    "seeded": {
      "items": {
        "additionalProperties": false,
        "required": [
          "id",
          "class",
          "page",
          "original_context",
          "mutated_context"
        ],
        "properties": {
          "original_context": {
            "type": "string"
          },
          "mutated_context": {
            "type": "string"
          },
          "class": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "page": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "salt": {
      "type": "string"
    },
    "schema_version": {
      "minimum": 1,
      "type": "integer",
      "description": "the tool MAJOR this artefact was written under"
    },
    "round": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-(check-docs|check-consistency|bug-hunt|audit-changes)-\\d{2}$",
      "type": "string"
    },
    "skipped": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "title": "ground_truth.json — seeded rounds, written at BANK",
  "type": "object"
}
