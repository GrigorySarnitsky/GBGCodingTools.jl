{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lane",
    "graded_sha256",
    "pass_nonce",
    "verdicts"
  ],
  "properties": {
    "graded_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "verdicts": {
      "items": {
        "additionalProperties": false,
        "required": [
          "id",
          "verdict",
          "question",
          "evidence",
          "class_surfaces"
        ],
        "properties": {
          "question": {
            "type": "string",
            "enum": [
              "fidelity",
              "strategy",
              "implementation",
              "scope",
              "none"
            ]
          },
          "id": {
            "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z-]+-\\d{2}/[a-z0-9-]+#\\d+$",
            "type": "string",
            "description": "<round>/<lane>#<n>"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "HONORED",
              "ADJACENT",
              "INSERTED",
              "LINE-ONLY",
              "NEW-DEFECT",
              "SCOPE-CREEP",
              "UNDONE",
              "LAUNDERED"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 10
          },
          "class_surfaces": {
            "items": {
              "additionalProperties": false,
              "required": [
                "surface",
                "swept",
                "evidence"
              ],
              "properties": {
                "swept": {
                  "type": "boolean"
                },
                "evidence": {
                  "type": "string"
                },
                "surface": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "lane": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "type": "string"
    },
    "schema_version": {
      "minimum": 1,
      "type": "integer",
      "description": "the tool MAJOR this artefact was written under"
    },
    "pass_nonce": {
      "pattern": "^[0-9a-f]{32}$",
      "type": "string"
    }
  },
  "title": "verdicts/pass-<k>/act/NN-<lane>.json — the act verifier (sees the diff)",
  "type": "object"
}
