# gbg:fragment auth
- name: Authenticate the private GBG dependencies
  # First step after actions/checkout, before any julia-actions/* step: Pkg fetches the pinned tool
  # over https, and the token rewrite is what lets a private repository resolve on the runner.
  env:
    GBG_DEPS_TOKEN: ${{ secrets.GBG_DEPS_TOKEN }}
  run: git config --global url."https://x-access-token:${GBG_DEPS_TOKEN}@github.com/".insteadOf "https://github.com/"
# gbg:fragment run
- name: Test
  # Replaces julia-actions/julia-runtest: the output is tee'd so the last step can prove the gate ran.
  env:
    JULIA_NUM_THREADS: ${{ matrix.threads }}
  run: |
    set -o pipefail
    julia --color=yes --project -e 'using Pkg; Pkg.test()' 2>&1 | tee gbg-run.log
# gbg:fragment banner
- name: The tool's gate ran
  # The gate prints `{{tool.banner}} gate` once it has been consulted; a green job whose log lacks the
  # banner ran the tests without the gate, which is the failure this step exists to catch.
  run: grep -q '{{tool.banner}} gate' gbg-run.log
