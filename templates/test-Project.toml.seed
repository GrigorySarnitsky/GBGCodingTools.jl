[deps]
GBGCodingTools = "{{tool.uuid}}"
# the package itself, so an `executable_claims` file runs on its own under `--project=test`: the
# audit runs each claim that way, and without this every claim fails to load the package
{{package.name}} = "{{package.uuid}}"
Test = "8dfed614-e22c-5e08-85e1-65c5234f0b40"

[sources]
GBGCodingTools = {url = "{{tool.url}}", rev = "v{{tool.version}}"}
{{package.name}} = {path = ".."}

[compat]
GBGCodingTools = "={{tool.version}}"
